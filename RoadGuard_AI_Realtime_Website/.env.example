# RoadGuard AI configuration. Copy to .env and replace placeholders.
SECRET_KEY=replace-with-a-long-random-secret
FLASK_ENV=development
HOST=127.0.0.1
PORT=5000
DEMO_EMAIL=admin@irie.ai
DEMO_PASSWORD=change-this-demo-password
DEMO_NAME=RoadGuard Operator
# Browser key: restrict by HTTP referrer and Maps JavaScript API. Publicly visible by design.
GOOGLE_MAPS_BROWSER_KEY=
# Server key: keep secret, restrict to Routes API. Never expose in frontend.
GOOGLE_MAPS_SERVER_API_KEY=
# Legacy server-key fallback supported by backend
GOOGLE_MAPS_API_KEY=
SERIAL_PORT=
SERIAL_BAUD_RATE=9600
REROUTE_MODE=approval
MAX_IMPACT_THRESHOLD_G=3.5
LOW_BATTERY_THRESHOLD_V=11.1
CRITICAL_TILT_DEG=35.0
